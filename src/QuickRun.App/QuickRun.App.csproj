<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../QuickRun.Core/QuickRun.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Spectre.Console.Cli" />
    <!-- The window hosts the local web UI where a system WebView exists. Managed wrappers only:
         the native loader is a win-* runtime asset, so a Linux or macOS publish does not carry it. -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- Embedded rather than copied next to the binary: Blazor-style static web assets are published
       as loose files, and the dashboard has to survive being a single file. -->
  <ItemGroup>
    <EmbeddedResource Include="Daemon/dashboard.html" />
    <!-- The config builder's editor and the schema it completes from, so both work offline. -->
    <EmbeddedResource Include="Daemon/monaco/**/*" LogicalName="monaco/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../schema/quickrun.schema.json" LogicalName="quickrun.schema.json" />
    <EmbeddedResource Include="../../assets/icon-round-256.png" LogicalName="QuickRun.App.Daemon.icon.png" />
  </ItemGroup>

  <!-- Kestrel for the localhost listener the browser extension talks to. -->
  <ItemGroup>
    <!-- The origin check that replaced pairing is internal; its tests need to see it. -->
    <InternalsVisibleTo Include="QuickRun.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <!-- WinExe, so double-clicking opens no console window. ConsoleAttach re-attaches to a
         parent console when there is one, which keeps the CLI usable from a terminal. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>quickrun</AssemblyName>
    <RootNamespace>QuickRun.App</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Avalonia ships Skia and friends as native libraries; without this they are published as
         loose files next to the executable and the single-binary promise is gone. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- The WebView2 package also carries WPF and WinForms wrappers, which reference a WindowsBase
         this app never loads. Only the Core assembly is used, so the conflict is noise. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzz ship 100 MB of native .pdb files. They arrive as native runtime
       items, so AllowedReferenceRelatedFileExtensions does not reach them. -->
  <Target Name="StripPdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
